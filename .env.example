# Blank uses the Vite proxy in development and Nginx proxy in containers.
# For independent hosting use the HTTPS origin of the backend, without /api.
VITE_API_URL=
# Development proxy only; never embedded in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:8001
# Nginx container only: exact trusted TLS ingress peer/subnet.
TRUSTED_INGRESS_CIDR=127.0.0.1/32
